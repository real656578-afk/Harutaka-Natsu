<!DOCTYPE html>
<html>

<head>
    <title>Harutaka Natsu</title>

    <style>
        body{
            background-image: url("backgrond.jpg");
            background-repeat: repeat;
            font-family: "Times New Roman", serif;
            margin: 40px;
        }

        .header{
            animation: fadeIn 2s;
            text-align: center;
        }

footer{
    text-align: center;
    margin-top: 50px;
    color: gray;
    padding: 20px;
}

        #sakura-container{
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
}

.sakura{
    position: absolute;
    font-size: 20px;
    animation: fall linear infinite;
}

@keyframes fall{

    0%{
        transform: translate(0px,-50px) rotate(0deg);
        opacity:1;
    }

    50%{
        transform: translate(80px,50vh) rotate(180deg);
    }

    100%{
        transform: translate(-80px,110vh) rotate(360deg);
        opacity:0;
    }
}

.star{
    position: fixed;
    color: white;
    pointer-events: none;
    animation: twinkle 2s infinite;
}

@keyframes twinkle{

    0%,100%{
        opacity: 0.3;
    }

    50%{
        opacity: 1;
    }
}

    0%{
        transform: translateY(-50px);
        opacity: 1;
    }

    100%{
        transform: translateY(110vh);
        opacity: 0;
    }

        @keyframes fadeIn{
            from{
            opacity: 0;
            transform: translateY(-30px);
        }

        to{
            opacity: 1;
            transform: translateY(0);
        }
    }

        h1{
            text-shadow: 3px 3px 8px rgba(0,0,0,0.2);
            text-shadow:
            0 0 10px white,
            0 0 20px pink,
            0 0 30px violet;
}

        html{
            scroll-behavior: smooth;
        }

        .profile{
            width:150px;
            height:150px;
            border-radius:50%;
            object-fit: cover;
        }

       .card{
            background: white;

            padding: 20px;
            margin-bottom: 30px;

            border: 3px solid #305cba;
            border-radius: 20px;

            box-shadow: 0 8px 32px rgba(0,0,0,0.2);
            transition: 0.3s;
        }

        .card:hover{
            transform: translateY(-10px);
            box-shadow:
            0 0 40px rgba(123,104,238,1),
            0 10px 25px rgba(0,0,0,0.3);
        }

        nav{
            margin-top: 20px;
        }

        nav a{
            margin: 0 15px;
            text-decoration: none;
            color: #305cba;
            font-weight: bold;
        }

        nav a:hover{
            color: #7b68ee;
            text-decoration: underline;
        }

        img{
            border-radius: 10px;
            transition: 0.3s;
        }

        img:hover{
            transform: scale(1.05);
        }

        .profile{
            width:150px;
            border-radius:50%;
        }
    </style>
</head>

<body>

